{
  "name": "http-challenge-fabric",
  "version": "1.0.0",
  "description": "Handle HTTP Challenge for Let's Encrypt",
  "prettier": "@harperdb/code-guidelines/prettier",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "harper-integration-test-run \"integrationTests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write lib resources test integrationTests",
    "format:check": "prettier --check lib resources test integrationTests"
  },
  "dependencies": {
    "@harperdb/code-guidelines": "^0.0.2",
    "acme-client": "^5.4.0"
  },
  "devDependencies": {
    "@harperfast/integration-testing": "^1.0.5",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.6.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "harper": "^5.3.2",
    "prettier": "^3.3.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "acme-client": {
      "axios": "1.13.2"
    }
  }
}
